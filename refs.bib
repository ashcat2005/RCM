@article{Straumann2011,
author = {Straumann, N.},
title = {Einstein's ‘Zürich Notebook’ and his journey to general relativity},
journal = {Annalen der Physik},
volume = {523},
number = {6},
pages = {488-500},
keywords = {History of general relativity, Einstein-Grossmann theory, gravitational field equations, general covariance, Einstein-Fokker theory.},
doi = {10.1002/andp.201110467},
url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/andp.201110467},
eprint = {https://onlinelibrary.wiley.com/doi/pdf/10.1002/andp.201110467},
abstract = {Abstract On the basis of his ‘Zürich Notebook’ I shall describe a particularly fruitful phase in Einstein's struggle on the way to general relativity. These research notes are an extremely illuminating source for understanding Einstein's main physical arguments and conceptual difficulties that delayed his discovery of general relativity by about three years. Together with the ‘Entwurf’ theory in collaboration with Marcel Grossmann, these notes also show that the final theory was missed late in 1912 within a hair's breadth. The Einstein-Grossmann theory, published almost exactly hundred years ago, contains, however, virtually all essential elements of Einstein's definite gravitation theory.},
year = {2011}
}


